---

<section
  id="escuchanos"
  class="py-20 md:py-28 px-4 md:px-8"
  style="background: #0F0F0F;"
>
  <div class="max-w-5xl mx-auto">
    <div class="text-center mb-14">
      <div
        class="badge bg-orange-podcast border-2 border-white mb-3"
        style="box-shadow: 2px 2px 0 rgba(255,255,255,0.25);"
      >
        Síguenos
      </div>
      <h2
        class="font-black text-white"
        style="font-size: clamp(34px, 5vw, 56px); letter-spacing: -2px;"
      >
        Escúchanos donde quieras
      </h2>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 md:gap-5">
      {SOCIALS.map((s) => {
        const isAvail = s.link !== '#';
        return (
          <a
            href={s.link}
            target={isAvail ? '_blank' : undefined}
            rel="noopener"
            class={`social-card flex flex-col items-center gap-3 px-4 py-7 rounded-2xl border-2 border-white text-center transition-all duration-150 ${!isAvail ? 'opacity-55 cursor-default' : 'cursor-pointer'}`}
            style={`background: ${s.bg}; box-shadow: 4px 4px 0 rgba(255,255,255,0.15);`}
            data-available={isAvail}
          >
            <div set:html={iconPaths[s.name] || ''} />
            <div>
              <div class="font-black text-sm text-dark">{s.name}</div>
              <div class="font-semibold text-xs text-dark/50 mt-0.5">{s.desc}</div>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('.social-card').forEach(card => {
    if ((card as HTMLElement).dataset.available === 'true') {
      card.addEventListener('mouseenter', () => {
        (card as HTMLElement).style.transform = 'translate(-2px, -2px)';
        (card as HTMLElement).style.boxShadow = '6px 6px 0 rgba(255,255,255,0.25)';
      });
      card.addEventListener('mouseleave', () => {
        (card as HTMLElement).style.transform = '';
        (card as HTMLElement).style.boxShadow = '4px 4px 0 rgba(255,255,255,0.15)';
      });
    }
  });
</script>

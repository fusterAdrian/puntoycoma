---
// Obtén tu clave gratuita en https://web3forms.com (introduce puntoycomacontactopod@gmail.com)
const WEB3FORMS_KEY = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
---

<section
  id="contacto"
  class="py-20 md:py-28 px-4 md:px-8 border-t-2 border-dark"
  style="background: #F2EDE3;"
>
  <div class="max-w-2xl mx-auto">
    <div class="text-center mb-12">
      <div
        class="badge bg-sky-podcast mb-3"
      >
        Contacto
      </div>
      <h2
        class="font-black mb-3"
        style="font-size: clamp(34px, 5vw, 56px); letter-spacing: -2px;"
      >
        ¿Nos escribes?
      </h2>
      <p class="font-semibold text-base text-dark/58 leading-relaxed">
        Sugerencias, colaboraciones o simplemente decirnos hola. ¡Estamos para lo que necesites!
      </p>
    </div>

    <!-- Success state (hidden by default) -->
    <div
      id="form-success"
      class="hidden bg-orange-podcast border-2 border-dark rounded-2xl p-11 text-center animate-pop"
      style="box-shadow: 6px 6px 0 #1A1A1A;"
    >
      <div class="text-5xl mb-3">✌️</div>
      <h3 class="font-black text-2xl mb-2">¡Mensaje enviado!</h3>
      <p class="font-semibold text-base">Lo hemos recibido y te responderemos pronto. ¡Gracias!</p>
    </div>

    <!-- Error state (hidden by default) -->
    <div
      id="form-error"
      class="hidden bg-red-100 border-2 border-red-500 rounded-2xl p-6 text-center mb-4"
    >
      <p class="font-semibold text-base text-red-700">Algo fue mal al enviar el mensaje. Por favor, inténtalo de nuevo.</p>
    </div>

    <!-- Form -->
    <form
      id="contact-form"
      class="bg-offwhite border-2 border-dark rounded-2xl p-8 md:p-11 flex flex-col gap-5"
      style="box-shadow: 6px 6px 0 #1A1A1A;"
      novalidate
    >
      <input type="hidden" id="w3f-key" value={WEB3FORMS_KEY} />

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="field-name" class="block font-extrabold text-xs uppercase tracking-wide mb-2">Nombre</label>
          <input
            id="field-name"
            name="name"
            type="text"
            placeholder="Tu nombre"
            class="form-field"
            autocomplete="name"
          />
          <p id="error-name" class="hidden text-red-600 text-xs font-semibold mt-1">El nombre es obligatorio.</p>
        </div>
        <div>
          <label for="field-email" class="block font-extrabold text-xs uppercase tracking-wide mb-2">Email</label>
          <input
            id="field-email"
            name="email"
            type="email"
            placeholder="tu@email.com"
            class="form-field"
            autocomplete="email"
          />
          <p id="error-email" class="hidden text-red-600 text-xs font-semibold mt-1">Introduce un email válido.</p>
        </div>
      </div>
      <div>
        <label for="field-message" class="block font-extrabold text-xs uppercase tracking-wide mb-2">Mensaje</label>
        <textarea
          id="field-message"
          name="message"
          placeholder="¿En qué podemos ayudarte?"
          class="form-field resize-y min-h-32"
        ></textarea>
        <p id="error-message" class="hidden text-red-600 text-xs font-semibold mt-1">El mensaje es obligatorio.</p>
      </div>
      <button
        id="form-submit"
        type="submit"
        class="btn btn-orange text-base self-start px-8 py-3.5"
      >
        Enviar mensaje ✉️
      </button>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const successBox = document.getElementById('form-success')!;
  const errorBox = document.getElementById('form-error')!;
  const submitBtn = document.getElementById('form-submit') as HTMLButtonElement;

  const fieldName = document.getElementById('field-name') as HTMLInputElement;
  const fieldEmail = document.getElementById('field-email') as HTMLInputElement;
  const fieldMessage = document.getElementById('field-message') as HTMLTextAreaElement;

  const errorName = document.getElementById('error-name')!;
  const errorEmail = document.getElementById('error-email')!;
  const errorMessage = document.getElementById('error-message')!;

  function isValidEmail(email: string): boolean {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
  }

  function setFieldError(input: HTMLElement, errorEl: HTMLElement, show: boolean) {
    if (show) {
      input.classList.add('field-error');
      errorEl.classList.remove('hidden');
    } else {
      input.classList.remove('field-error');
      errorEl.classList.add('hidden');
    }
  }

  function validate(): boolean {
    const name = fieldName.value.trim();
    const email = fieldEmail.value.trim();
    const message = fieldMessage.value.trim();

    const nameInvalid = !name;
    const emailInvalid = !email || !isValidEmail(email);
    const messageInvalid = !message;

    setFieldError(fieldName, errorName, nameInvalid);
    setFieldError(fieldEmail, errorEmail, emailInvalid);
    setFieldError(fieldMessage, errorMessage, messageInvalid);

    return !nameInvalid && !emailInvalid && !messageInvalid;
  }

  [fieldName, fieldEmail, fieldMessage].forEach((field) => {
    field.addEventListener('input', () => {
      const errorEl =
        field === fieldName ? errorName :
        field === fieldEmail ? errorEmail :
        errorMessage;
      setFieldError(field, errorEl, false);
    });
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (!validate()) return;

    submitBtn.disabled = true;
    submitBtn.textContent = 'Enviando…';
    errorBox.classList.add('hidden');

    try {
      const accessKey = (document.getElementById('w3f-key') as HTMLInputElement).value;

      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          access_key: accessKey,
          subject: `Mensaje de ${fieldName.value.trim()} — Punto y Coma Podcast`,
          name: fieldName.value.trim(),
          email: fieldEmail.value.trim(),
          message: fieldMessage.value.trim(),
        }),
      });

      const data = await res.json();

      if (data.success) {
        form.classList.add('hidden');
        successBox.classList.remove('hidden');
      } else {
        throw new Error(data.message ?? 'Error desconocido');
      }
    } catch {
      errorBox.classList.remove('hidden');
      submitBtn.disabled = false;
      submitBtn.textContent = 'Enviar mensaje ✉️';
    }
  });
</script>

---
import type { Episode } from '../data/content';
import { THUMB_COLORS } from '../data/content';

interface Props {
  episodes: Episode[];
}

const { episodes } = Astro.props;
---

<section id="capitulos" class="py-20 md:py-28 px-4 md:px-8 bg-offwhite">
  <div class="max-w-7xl mx-auto">
    <div class="mb-12 md:mb-16">
      <div class="flex flex-wrap items-center gap-2 mb-3">
        <div class="badge bg-orange-podcast -rotate-1">Capítulos</div>
        <button
          class="filter-btn font-black text-xs px-3 py-1.5 rounded-lg border-2 border-dark transition-all duration-150"
          data-filter="all"
          style="box-shadow: 2px 2px 0 #1A1A1A; background: #1A1A1A; color: #F5F0E8;"
        >Todos</button>
        <button
          class="filter-btn font-black text-xs px-3 py-1.5 rounded-lg border-2 border-dark transition-all duration-150"
          data-filter="episode"
          style="box-shadow: 2px 2px 0 #1A1A1A; background: #F5F0E8; color: #1A1A1A;"
        >Episodios</button>
        <button
          class="filter-btn font-black text-xs px-3 py-1.5 rounded-lg border-2 border-dark transition-all duration-150"
          data-filter="interview"
          style="box-shadow: 2px 2px 0 #1A1A1A; background: #F5F0E8; color: #1A1A1A;"
        >Entrevistas</button>
      </div>
      <h2
        class="font-black leading-tight"
        style="font-size: clamp(34px, 5vw, 56px); letter-spacing: -2px;"
      >
        Todos los episodios
      </h2>
    </div>

    {episodes.length === 0 ? (
      <div class="text-center py-20 opacity-50 font-semibold">
        No hay episodios disponibles aún.
      </div>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-7">
        {episodes.map((ep) => {
          const bg = THUMB_COLORS[(ep.id - 1) % THUMB_COLORS.length];
          return (
            <article
              class="episode-card card-brutal flex flex-col cursor-pointer overflow-hidden"
              data-episode-id={ep.id}
              data-type={ep.type ?? 'episode'}
            >
              <!-- Thumbnail -->
              <div class="relative">
                <div
                  class="w-full aspect-video flex items-center justify-center relative overflow-hidden border-b-2 border-dark"
                  style={`background: ${bg};`}
                >
                  {ep.thumbnail ? (
                    <img
                      src={ep.thumbnail}
                      alt={ep.title}
                      class="absolute inset-0 w-full h-full object-cover"
                      loading="lazy"
                    />
                  ) : (
                    <>
                      <div
                        class="absolute inset-0"
                        style="background-image: radial-gradient(circle, rgba(0,0,0,0.07) 1.5px, transparent 1.5px); background-size: 18px 18px;"
                      ></div>
                      <img
                        src="/images/mascota.jpg"
                        class="w-16 h-16 rounded-full border-2 border-dark object-cover relative z-10"
                        style="box-shadow: 3px 3px 0 #1A1A1A;"
                        alt=""
                      />
                    </>
                  )}
                  <div class="absolute bottom-2.5 right-2.5 w-9 h-9 bg-dark/85 rounded-full flex items-center justify-center z-10">
                    <span class="text-white text-xs ml-0.5">▶</span>
                  </div>
                  <div class="absolute bottom-2.5 left-2.5 bg-dark/75 text-white rounded-md px-2 py-0.5 text-xs font-bold z-10">
                    {ep.duration}
                  </div>
                </div>
                <!-- EP / ENT badge -->
                <div
                  class="absolute top-2.5 left-2.5 border-2 border-dark rounded-lg px-2.5 py-0.5 font-black text-xs -rotate-2"
                  style={`box-shadow: 2px 2px 0 #1A1A1A; background: ${ep.type === 'interview' ? '#C4F0C5' : 'var(--color-orange-podcast, #F5A623)'};`}
                >
                  {ep.type === 'interview' ? 'ENT.' : 'EP.'} {String(ep.id).padStart(2, '0')}
                </div>
              </div>

              <!-- Content -->
              <div class="p-4 md:p-5 flex flex-col flex-1">
                <p class="font-bold text-xs text-dark/45 mb-1.5">{ep.date}</p>
                <h3 class="font-black text-base leading-snug mb-2 line-clamp-2">{ep.title}</h3>
                <p class="font-semibold text-sm text-dark/58 leading-relaxed mb-4 flex-1 line-clamp-3">{ep.description}</p>
                <div class="flex items-center justify-between mt-auto">
                  <span
                    class="font-bold text-xs bg-sky-podcast px-2.5 py-1 rounded-full border border-dark/30"
                  >
                    {ep.duration}
                  </span>
                  <span class="font-extrabold text-sm ep-arrow transition-colors duration-150">Ver episodio →</span>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    )}
  </div>
</section>

<script>
  const cards = document.querySelectorAll<HTMLElement>('.episode-card');
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');

  cards.forEach(card => {
    card.addEventListener('click', () => {
      window.location.href = `/episodio/${card.dataset.episodeId}`;
    });
    card.addEventListener('mouseenter', () => {
      const arrow = card.querySelector('.ep-arrow') as HTMLElement;
      if (arrow) arrow.style.color = '#D4881A';
    });
    card.addEventListener('mouseleave', () => {
      const arrow = card.querySelector('.ep-arrow') as HTMLElement;
      if (arrow) arrow.style.color = '';
    });
  });

  function applyFilter(filter: string) {
    cards.forEach(card => {
      const type = card.dataset.type ?? 'episode';
      const visible = filter === 'all' || type === filter;
      card.style.display = visible ? '' : 'none';
    });

    filterBtns.forEach(btn => {
      const active = btn.dataset.filter === filter;
      btn.style.background = active ? '#1A1A1A' : '#F5F0E8';
      btn.style.color = active ? '#F5F0E8' : '#1A1A1A';
    });
  }

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => applyFilter(btn.dataset.filter ?? 'all'));
  });
</script>

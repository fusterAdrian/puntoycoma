---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Punto y Coma — Podcast de Tech & Programación',
  description = 'Alejandro y Adrián debaten sobre novedades de programación, inteligencia artificial y los productos tech que más nos interesan. Sin filtros.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/jpeg" href="/images/mascota.jpg" />
    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/mascota.jpg" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="font-nunito bg-offwhite text-dark overflow-x-hidden">
    <slot />
  </body>
</html>

---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 — Página no encontrada | Punto y Coma">
  <div class="min-h-screen flex flex-col items-center justify-center px-4 text-center" style="background: #A8D4E8;">
    <div
      class="bg-offwhite border-2 border-dark rounded-2xl px-12 py-14 max-w-md"
      style="box-shadow: 8px 8px 0 #1A1A1A;"
    >
      <div class="text-6xl mb-4">🎙️</div>
      <h1 class="font-black text-4xl mb-3" style="letter-spacing: -2px;">404</h1>
      <p class="font-semibold text-base text-dark/60 mb-8 leading-relaxed">
        Esta página no existe, pero sí que tenemos episodios geniales esperándote.
      </p>
      <a href="/" class="btn btn-dark text-base">← Volver al inicio</a>
    </div>
  </div>
</Layout>
